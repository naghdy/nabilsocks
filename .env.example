# Local / Vercel environment (no secrets).

# Stripe — https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ / pk_test_. Live keys start with sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL used for Stripe success/cancel redirects.
# On Vercel this can be omitted (VERCEL_URL is used). Set it for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Printify — https://printify.com/app/account/api
# Token needs orders.read, orders.write, products.read.
PRINTIFY_API_TOKEN=
# Non-secret shop that holds the ten crew drafts. Code also defaults to this.
PRINTIFY_SHOP_ID=28967994

# Optional: JSON overlay for slug → Printify product/variant ids (same shape as lib/printify-map.json).
# PRINTIFY_MAP_JSON={"circuit-crew":{"printifyProductId":"hexid","variants":{"S":1,"M":2,"L":3}}}

# Optional: Printify shipping method id (1 = standard). See Printify shipping calculator.
# PRINTIFY_SHIPPING_METHOD=1

# Optional: send Printify orders to production.
# Default: true for Stripe live mode, false for Stripe test mode.
# PRINTIFY_SEND_TO_PRODUCTION=false
